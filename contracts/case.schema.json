{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "玩具认证冒用排查卷宗",
  "type": "object",
  "required": [
    "case_id",
    "certificates",
    "batches",
    "flows",
    "sales",
    "evidence",
    "scans"
  ],
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "certificates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cert_id", "events"],
        "additionalProperties": false,
        "properties": {
          "cert_id": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["at", "kind"],
              "additionalProperties": false,
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "kind": {
                  "enum": ["issued", "suspended", "restored", "rebound"]
                },
                "models": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "batch",
          "model",
          "packaging_version",
          "printed_cert",
          "produced_at",
          "quantity"
        ],
        "additionalProperties": false,
        "properties": {
          "batch": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "packaging_version": {
            "type": "string",
            "minLength": 1
          },
          "printed_cert": {
            "type": "string",
            "minLength": 1
          },
          "produced_at": {
            "type": "string",
            "format": "date-time"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "batch", "to_store", "quantity", "shipped_at", "received_at"],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "batch": {
            "type": "string",
            "minLength": 1
          },
          "to_store": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "shipped_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "sales": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["store", "batch", "quantity", "started_at", "ended_at"],
        "additionalProperties": false,
        "properties": {
          "store": {
            "type": "string",
            "minLength": 1
          },
          "batch": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "at", "ref"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": ["warehousing", "sampling_photo", "interview"]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "batch": {
            "type": "string"
          },
          "store": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "scans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit", "batch", "scanned_cert", "at", "source"],
        "additionalProperties": false,
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "batch": {
            "type": "string",
            "minLength": 1
          },
          "scanned_cert": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rectifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["submitted_by", "at", "note"],
        "additionalProperties": false,
        "properties": {
          "submitted_by": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "consumer_notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["store", "batch", "reached", "at"],
        "additionalProperties": false,
        "properties": {
          "store": {
            "type": "string",
            "minLength": 1
          },
          "batch": {
            "type": "string",
            "minLength": 1
          },
          "reached": {
            "type": "integer",
            "minimum": 0
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "batches",
          "cert_id",
          "cert_version",
          "flow_refs",
          "reach",
          "decided_at"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": ["penalty", "lift-measures"]
          },
          "batches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cert_id": {
            "type": "string",
            "minLength": 1
          },
          "cert_version": {
            "type": "integer",
            "minimum": 1
          },
          "flow_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reach": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["store", "batch", "reached", "at"],
              "additionalProperties": false,
              "properties": {
                "store": {
                  "type": "string",
                  "minLength": 1
                },
                "batch": {
                  "type": "string",
                  "minLength": 1
                },
                "reached": {
                  "type": "integer",
                  "minimum": 0
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
