{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "玩具认证冒用排查共享资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "actors",
    "facts",
    "constraints",
    "certificates",
    "stores",
    "timeline",
    "lots",
    "reports",
    "certificate_status",
    "notices",
    "dispositions"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "facts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "certificates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "certificate_id",
          "version",
          "holder",
          "scope_models",
          "issued_at",
          "status"
        ],
        "properties": {
          "certificate_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "holder": {
            "type": "string",
            "minLength": 1
          },
          "scope_models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "issued_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "enum": [
              "有效",
              "暂停",
              "恢复",
              "换绑",
              "撤销"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "occurred_at",
          "kind",
          "actor",
          "summary",
          "refs"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "证书范围",
              "包装版本",
              "生产入库",
              "供货门店",
              "销售记录",
              "扫码上报",
              "抽样照片",
              "询问笔录",
              "跨地区补报",
              "整改补交",
              "处置决定"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lot_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "lots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lot_id",
          "model",
          "packaging_version",
          "quantity",
          "holder",
          "status"
        ],
        "properties": {
          "lot_id": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "packaging_version": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "holder": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "在库",
              "在架",
              "已售",
              "下架",
              "召回"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "report_id",
          "source",
          "reported_at",
          "lot_ids"
        ],
        "properties": {
          "report_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "批量扫码",
              "跨地区补报"
            ]
          },
          "reported_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lot_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "certificate_status": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "certificate_id",
          "certificate_version",
          "changed_at",
          "status",
          "note"
        ],
        "properties": {
          "certificate_id": {
            "type": "string",
            "minLength": 1
          },
          "certificate_version": {
            "type": "string",
            "minLength": 1
          },
          "changed_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "enum": [
              "有效",
              "暂停",
              "恢复",
              "换绑",
              "撤销"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "notice_id",
          "to",
          "sent_at",
          "action",
          "lot_ids"
        ],
        "properties": {
          "notice_id": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "sent_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "lot_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "disposition_id",
          "kind",
          "decided_at",
          "lot_ids",
          "certificate_id",
          "certificate_version",
          "flow_refs",
          "consumer_reach",
          "summary"
        ],
        "properties": {
          "disposition_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "处罚",
              "解除措施"
            ]
          },
          "decided_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lot_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "certificate_id": {
            "type": "string",
            "minLength": 1
          },
          "certificate_version": {
            "type": "string",
            "minLength": 1
          },
          "flow_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "consumer_reach": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
